    'Name', '视频转 GIF 工具', ...
    'NumberTitle', 'off', ...
    'MenuBar', 'none', ...
    'ToolBar', 'none', ...
    'Resize', 'off', ...
    'Position', [500 180 680 540], ...
    'Color', [0.94 0.94 0.94]);

uicontrol(fig, ...
    'Style', 'text', ...
    'String', '视频 → GIF 转换工具', ...
    'FontSize', 17, ...
    'FontWeight', 'bold', ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [190 490 300 35]);

%% =========================
% 输入视频
% ==========================
uicontrol(fig, ...
    'Style', 'text', ...
    'String', '输入视频：', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 10, ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [35 440 80 25]);

inputEdit = uicontrol(fig, ...
    'Style', 'edit', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 10, ...
    'Position', [115 440 420 28]);

uicontrol(fig, ...
    'Style', 'pushbutton', ...
    'String', '选择文件...', ...
    'FontSize', 10, ...
    'Position', [550 440 95 28], ...
    'Callback', @selectInput);

%% =========================
% 输出 GIF
% ==========================
uicontrol(fig, ...
    'Style', 'text', ...
    'String', '输出 GIF：', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 10, ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [35 395 80 25]);

outputEdit = uicontrol(fig, ...
    'Style', 'edit', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 10, ...
    'Position', [115 395 420 28]);

uicontrol(fig, ...
    'Style', 'pushbutton', ...
    'String', '输出路径...', ...
    'FontSize', 10, ...
    'Position', [550 395 95 28], ...
    'Callback', @selectOutput);

%% =========================
% 时间范围
% ==========================
uicontrol(fig, ...
    'Style', 'text', ...
    'String', '截取时间：', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 10, ...
    'FontWeight', 'bold', ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [35 340 80 25]);

uicontrol(fig, ...
    'Style', 'text', ...
    'String', '开始', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 10, ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [115 340 40 25]);

startTimeEdit = uicontrol(fig, ...
    'Style', 'edit', ...
    'String', '0', ...
    'FontSize', 10, ...
    'Position', [155 340 80 28]);

uicontrol(fig, ...
    'Style', 'text', ...
    'String', '秒', ...
    'FontSize', 10, ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [240 340 30 25]);

uicontrol(fig, ...
    'Style', 'text', ...
    'String', '结束', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 10, ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [285 340 40 25]);

endTimeEdit = uicontrol(fig, ...
    'Style', 'edit', ...
    'String', '0', ...
    'FontSize', 10, ...
    'Position', [325 340 80 28]);

uicontrol(fig, ...
    'Style', 'text', ...
    'String', '秒', ...
    'FontSize', 10, ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [410 340 30 25]);

durationText = uicontrol(fig, ...
    'Style', 'text', ...
    'String', '视频长度：--', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 9, ...
    'ForegroundColor', [0.3 0.3 0.3], ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [460 340 185 25]);

%% =========================
% GIF质量
% ==========================
uicontrol(fig, ...
    'Style', 'text', ...
    'String', 'GIF 质量：', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 10, ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [35 285 80 25]);

qualitySlider = uicontrol(fig, ...
    'Style', 'slider', ...
    'Min', 10, ...
    'Max', 100, ...
    'Value', 90, ...
    'SliderStep', [0.01 0.1], ...
    'Position', [115 285 310 25], ...
    'Callback', @qualityChanged);

qualityText = uicontrol(fig, ...
    'Style', 'text', ...
    'String', '90 %', ...
    'FontSize', 10, ...
    'FontWeight', 'bold', ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [440 285 60 25]);

uicontrol(fig, ...
    'Style', 'text', ...
    'String', '低 ← 文件较小                     画质较高 → 高', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 8, ...
    'ForegroundColor', [0.35 0.35 0.35], ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [115 260 330 20]);

%% =========================
% 播放倍速
% ==========================
uicontrol(fig, ...
    'Style', 'text', ...
    'String', '播放倍速：', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 10, ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [35 215 80 25]);

speedEdit = uicontrol(fig, ...
    'Style', 'edit', ...
    'String', '1.0', ...
    'FontSize', 10, ...
    'Position', [115 215 80 28]);

uicontrol(fig, ...
    'Style', 'text', ...
    'String', '×', ...
    'FontSize', 11, ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [200 215 20 25]);

uicontrol(fig, ...
    'Style', 'text', ...
    'String', '0.5 = 半速    1 = 原速    2 = 两倍速', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 9, ...
    'ForegroundColor', [0.35 0.35 0.35], ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [230 215 300 25]);

%% =========================
% 输出 FPS
% ==========================
uicontrol(fig, ...
    'Style', 'text', ...
    'String', '输出 FPS：', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 10, ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [35 170 80 25]);

fpsEdit = uicontrol(fig, ...
    'Style', 'edit', ...
    'String', '15', ...
    'FontSize', 10, ...
    'Position', [115 170 80 28]);

uicontrol(fig, ...
    'Style', 'text', ...
    'String', 'FPS    （0 = 使用原视频帧率）', ...
    'HorizontalAlignment', 'left', ...
    'FontSize', 9, ...
    'ForegroundColor', [0.35 0.35 0.35], ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [205 170 260 25]);

%% =========================
% Dither
% ==========================
ditherCheck = uicontrol(fig, ...
    'Style', 'checkbox', ...
    'String', '启用颜色抖动 Dithering（渐变更自然）', ...
    'Value', 1, ...
    'FontSize', 9, ...
    'BackgroundColor', get(fig,'Color'), ...
    'Position', [115 125 360 25]);

%% =========================
% 转换按钮
% ==========================
startButton = uicontrol(fig, ...
    'Style', 'pushbutton', ...
    'String', '开始转换 GIF', ...
    'FontSize', 12, ...
    'FontWeight', 'bold', ...
    'Position', [240 60 200 42], ...
    'Callback', @startConversion);

%% =========================
% 状态
% ==========================
state.inputFile = '';
state.outputFile = '';
state.duration = 0;
guidata(fig,state);


%% =========================================================
% 选择输入视频
% ==========================================================
    function selectInput(~,~)

        [file,path] = uigetfile( ...
            { ...
            '*.mp4;*.avi;*.mov;*.m4v;*.mpg;*.mpeg;*.wmv', ...
            '视频文件 (*.mp4, *.avi, *.mov, *.m4v, *.mpg, *.mpeg, *.wmv)'; ...
            '*.*','所有文件 (*.*)' ...
            }, ...
            '选择要转换的视频');

        if isequal(file,0)
            return;
        end

        inputFile = fullfile(path,file);

        try
            video = VideoReader(inputFile);
            duration = video.Duration;
        catch ME
            errordlg(sprintf('无法读取视频：\n%s',ME.message), ...
                '读取失败');
            return;
        end

        set(inputEdit,'String',inputFile);

        % 自动填入完整视频时间范围
        set(startTimeEdit,'String','0');

        set(endTimeEdit, ...
            'String',sprintf('%.3f',duration));

        set(durationText, ...
            'String',sprintf('视频长度：%.3f 秒',duration));

        % 默认输出文件
        [~,name,~] = fileparts(file);
        outputFile = fullfile(path,[name '_GIF.gif']);

        set(outputEdit,'String',outputFile);

        state = guidata(fig);
        state.inputFile = inputFile;
        state.outputFile = outputFile;
        state.duration = duration;
        guidata(fig,state);
    end


%% =========================================================
% 选择输出路径
% ==========================================================
    function selectOutput(~,~)

        currentOutput = get(outputEdit,'String');

        if isempty(currentOutput)
            defaultName = 'output.gif';
        else
            defaultName = currentOutput;
        end

        [file,path] = uiputfile( ...
            {'*.gif','GIF 动画 (*.gif)'}, ...
            '选择 GIF 保存位置', ...
            defaultName);

        if isequal(file,0)
            return;
        end

        [~,~,ext] = fileparts(file);

        if isempty(ext)
            file = [file '.gif'];
        elseif ~strcmpi(ext,'.gif')
            file = [file '.gif'];
        end

        outputFile = fullfile(path,file);
        set(outputEdit,'String',outputFile);
    end


%% =========================================================
% 质量变化
% ==========================================================
    function qualityChanged(src,~)

        q = round(get(src,'Value'));

        set(qualityText, ...
            'String',sprintf('%d %%',q));
    end


%% =========================================================
% 开始转换
% ==========================================================
    function startConversion(~,~)

        inputFile = strtrim(get(inputEdit,'String'));
        outputFile = strtrim(get(outputEdit,'String'));

        %% 输入文件
        if isempty(inputFile) || ~exist(inputFile,'file')
            errordlg('请选择有效的视频文件。','输入错误');
            return;
        end

        if isempty(outputFile)
            errordlg('请选择 GIF 输出位置。','输出错误');
            return;
        end

        %% 输出后缀
        [outPath,outName,outExt] = fileparts(outputFile);

        if isempty(outExt)
            outputFile = ...
                fullfile(outPath,[outName '.gif']);

            set(outputEdit,'String',outputFile);
        end

        %% 读取视频信息
        try
            video = VideoReader(inputFile);
        catch ME
            errordlg(sprintf( ...
                '无法打开视频：\n%s',ME.message), ...
                '视频错误');
            return;
        end

        duration = video.Duration;
        sourceFPS = video.FrameRate;

        %% =========================
        % 时间参数
        % ==========================
        startTime = ...
            str2double(get(startTimeEdit,'String'));

        endTime = ...
            str2double(get(endTimeEdit,'String'));

        if isnan(startTime) || startTime < 0
            errordlg( ...
                '开始秒数必须是大于或等于 0 的数字。', ...
                '时间参数错误');
            return;
        end

        if isnan(endTime) || endTime <= 0
            errordlg( ...
                '结束秒数必须是大于 0 的数字。', ...
                '时间参数错误');
            return;
        end

        if startTime >= duration
            errordlg( ...
                sprintf( ...
                '开始时间不能超过视频长度 %.3f 秒。', ...
                duration), ...
                '时间参数错误');
            return;
        end

        if endTime > duration
            endTime = duration;

            set(endTimeEdit, ...
                'String',sprintf('%.3f',duration));
        end

        if endTime <= startTime
            errordlg( ...
                '结束时间必须大于开始时间。', ...
                '时间参数错误');
            return;
        end

        clipDuration = endTime - startTime;

        %% =========================
        % 其他参数
        % ==========================
        quality = round( ...
            get(qualitySlider,'Value'));

        speed = str2double( ...
            get(speedEdit,'String'));

        targetFPS = str2double( ...
            get(fpsEdit,'String'));

        ditherEnabled = ...
            get(ditherCheck,'Value');

        if isnan(speed) || speed <= 0
            errordlg( ...
                '播放倍速必须大于 0。', ...
                '参数错误');
            return;
        end

        if isnan(targetFPS) || targetFPS < 0
            errordlg( ...
                '输出 FPS 必须大于或等于 0。', ...
                '参数错误');
            return;
        end

        if targetFPS == 0
            targetFPS = sourceFPS;
        end

        targetFPS = min(targetFPS,sourceFPS);

        %% =========================
        % 抽帧
        % ==========================
        frameStep = max( ...
            1, ...
            round(sourceFPS/targetFPS));

        actualFPS = sourceFPS/frameStep;

        %% GIF速度
        delayTime = 1/(actualFPS*speed);

        % GIF通常以0.01秒为时间单位
        delayTime = max(delayTime,0.01);

        %% =========================
        % GIF颜色数
        % ==========================
        numberOfColors = round( ...
            16 + ...
            (quality/100)*(256-16));

        numberOfColors = ...
            max(2,min(256,numberOfColors));

        %% 覆盖确认
        if exist(outputFile,'file')

            choice = questdlg( ...
                '输出 GIF 已存在，是否覆盖？', ...
                '覆盖文件', ...
                '覆盖', ...
                '取消', ...
                '取消');

            if ~strcmp(choice,'覆盖')
                return;
            end
        end

        set(startButton,'Enable','off');

        waitHandle = [];

        try

            %% 跳到开始时间
            video.CurrentTime = startTime;

            estimatedFrames = ...
                max(1,ceil(clipDuration*sourceFPS));

            %% 进度窗口
            waitHandle = waitbar( ...
                0, ...
                '正在准备转换...', ...
                'Name','视频转 GIF', ...
                'CreateCancelBtn', ...
                'setappdata(gcbf,''canceling'',1)');

            setappdata(waitHandle, ...
                'canceling',0);

            %% 删除旧文件
            if exist(outputFile,'file')
                delete(outputFile);
            end

            sourceFrameCount = 0;
            gifFrameCount = 0;

            firstFrame = true;
            cancelled = false;

            %% =============================
            % 开始读取指定时间段
            % =============================
            while hasFrame(video) && ...
                    video.CurrentTime < endTime

                if getappdata( ...
                        waitHandle,'canceling')

                    cancelled = true;
                    break;
                end

                frame = readFrame(video);

                sourceFrameCount = ...
                    sourceFrameCount + 1;

                %% 抽帧
                if mod( ...
                        sourceFrameCount-1, ...
                        frameStep) == 0

                    gifFrameCount = ...
                        gifFrameCount + 1;

                    %% 灰度转RGB
                    if size(frame,3) == 1
                        frame = repmat( ...
                            frame,[1 1 3]);
                    end

                    %% RGB -> 索引色
                    if ditherEnabled

                        try
                            [indexedImage,map] = ...
                                rgb2ind( ...
                                frame, ...
                                numberOfColors, ...
                                'dither');
                        catch
                            [indexedImage,map] = ...
                                rgb2ind( ...
                                frame, ...
                                numberOfColors);
                        end

                    else

                        try
                            [indexedImage,map] = ...
                                rgb2ind( ...
                                frame, ...
                                numberOfColors, ...
                                'nodither');
                        catch
                            [indexedImage,map] = ...
                                rgb2ind( ...
                                frame, ...
                                numberOfColors);
                        end
                    end

                    %% 写 GIF
                    if firstFrame

                        imwrite( ...
                            indexedImage, ...
                            map, ...
                            outputFile, ...
                            'gif', ...
                            'LoopCount',inf, ...
                            'DelayTime',delayTime);

                        firstFrame = false;

                    else

                        imwrite( ...
                            indexedImage, ...
                            map, ...
                            outputFile, ...
                            'gif', ...
                            'WriteMode','append', ...
                            'DelayTime',delayTime);
                    end
                end

                %% =============================
                % 更新进度
                % =============================
                if mod(sourceFrameCount,3) == 0

                    currentVideoTime = ...
                        min(video.CurrentTime,endTime);

                    progress = ...
                        (currentVideoTime-startTime) ...
                        / clipDuration;

                    progress = ...
                        max(0,min(1,progress));

                    waitbar( ...
                        progress, ...
                        waitHandle, ...
                        sprintf( ...
                        ['正在转换...\n' ...
                         '视频时间：%.2f / %.2f 秒\n' ...
                         '截取区间：%.2f ~ %.2f 秒\n' ...
                         'GIF 帧数：%d\n' ...
                         '进度：%.1f %%'], ...
                        currentVideoTime, ...
                        duration, ...
                        startTime, ...
                        endTime, ...
                        gifFrameCount, ...
                        progress*100));

                    drawnow;
                end
            end

            %% 关闭进度条
            if isgraphics(waitHandle)
                delete(waitHandle);
            end

            %% =============================
            % 取消
            % =============================
            if cancelled

                if exist(outputFile,'file')
                    delete(outputFile);
                end

                msgbox( ...
                    '转换已取消，未完成的 GIF 已删除。', ...
                    '已取消', ...
                    'warn');

            else

                %% =============================
                % 完成
                % =============================
                msgbox( ...
                    sprintf( ...
                    ['GIF 转换完成！\n\n' ...
                     '截取时间：%.3f ~ %.3f 秒\n' ...
                     '原始片段长度：%.3f 秒\n' ...
                     '播放倍速：%.2f ×\n' ...
                     '最终播放时长约：%.3f 秒\n' ...
                     '源视频 FPS：%.2f\n' ...
                     'GIF FPS：%.2f\n' ...
                     'GIF 帧数：%d\n' ...
                     '颜色数量：%d\n\n' ...
                     '保存位置：\n%s'], ...
                    startTime, ...
                    endTime, ...
                    clipDuration, ...
                    speed, ...
                    clipDuration/speed, ...
                    sourceFPS, ...
                    actualFPS, ...
                    gifFrameCount, ...
                    numberOfColors, ...
                    outputFile), ...
                    '转换完成');

            end

        catch ME

            if ~isempty(waitHandle)
                if isgraphics(waitHandle)
                    delete(waitHandle);
                end
            end

            if exist(outputFile,'file')
                try
                    delete(outputFile);
                catch
                end
            end

            errordlg( ...
                sprintf( ...
                '转换失败：\n\n%s', ...
                ME.message), ...
                '转换错误');
        end

        set(startButton,'Enable','on');
    end
end
